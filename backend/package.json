{
  "name": "filmnama-backend",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=20.17.0"
  },
  "scripts": {
    "dev": "npm run build && node --watch dist/src/main.js",
    "start": "node dist/src/main.js",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings=0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "npm run build && node --test dist/test",
    "test:integration": "npm run build && node --test dist/test/integration",
    "prisma:generate": "prisma generate",
    "prisma:validate": "prisma validate",
    "migrate:deploy": "prisma migrate deploy",
    "seed:dev": "npm run build && node dist/prisma/seed.js",
    "create-admin": "npm run build && node dist/src/cli/create-admin.js"
  },
  "dependencies": {
    "@nestjs/common": "11.2.5",
    "@nestjs/core": "11.2.5",
    "@nestjs/platform-express": "11.2.5",
    "@nestjs/swagger": "11.4.7",
    "@prisma/client": "6.19.0",
    "argon2": "0.41.1",
    "bullmq": "5.61.2",
    "class-transformer": "0.5.1",
    "class-validator": "0.14.2",
    "cookie-parser": "1.4.7",
    "dotenv": "16.6.1",
    "express": "5.1.0",
    "file-type": "^21.3.4",
    "helmet": "8.1.0",
    "ioredis": "5.8.1",
    "jsonwebtoken": "9.0.2",
    "multer": "^2.4.0",
    "nestjs-pino": "4.4.1",
    "pino": "9.12.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "sanitize-html": "2.17.0",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@eslint/js": "9.39.1",
    "@nestjs/testing": "11.2.5",
    "@types/cookie-parser": "1.4.9",
    "@types/express": "5.0.5",
    "@types/jsonwebtoken": "9.0.10",
    "@types/multer": "^2.2.0",
    "@types/node": "20.17.30",
    "@types/sanitize-html": "2.16.0",
    "@types/supertest": "6.0.3",
    "eslint": "9.39.1",
    "prettier": "3.6.2",
    "prisma": "6.19.0",
    "supertest": "7.1.4",
    "typescript": "5.9.3",
    "typescript-eslint": "8.46.3"
  }
}
