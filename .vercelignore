# Vercel deployment excludes. NOTE: this file applies to BOTH Vercel projects
# (frontend at repo root AND backend with rootDirectory=backend), and patterns
# without a slash match at any depth — so keep backend/ uploadable and only
# drop secrets, logs and junk. The frontend imports
# backend/prisma/course-content.json; the backend project needs all of backend/.
.env*
*.log
/api/
.test-dist/
coverage/
